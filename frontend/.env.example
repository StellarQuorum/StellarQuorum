# Quorum frontend configuration.
#
# Copy to frontend/.env.local (`cp .env.example .env.local`) and fill in. Every
# variable is validated at startup by frontend/lib/env.ts: a missing or
# malformed value fails immediately with a message naming the variable, rather
# than surfacing as a decoding error from inside the Stellar SDK.

# --- Contract ------------------------------------------------------------

# Governance contract the app reads proposals from. A Soroban contract ID is a
# 56-character strkey starting with C. Required unless fixture mode is on.
NEXT_PUBLIC_GOVERNANCE_CONTRACT_ID=

# Token contract balances are read from. Same format. Optional: QuorumClient
# falls back to the token address in get_config().
NEXT_PUBLIC_TOKEN_CONTRACT_ID=

# --- Network -------------------------------------------------------------

# Soroban RPC endpoint. Must be an absolute http(s) URL.
# Default: https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_RPC_URL=

# Network passphrase of the network the contract was deployed to. Must match
# the RPC endpoint, or every transaction fails signature verification.
# Default: Test SDF Network ; September 2015
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=

# --- App behaviour -------------------------------------------------------

# 1 serves the bundled mock proposals from frontend/lib/proposals.ts, so the UI
# runs with no deployment. 0 requires a contract ID and fails fast without one —
# set it in a deployment so a missing contract never silently serves fixtures.
# Default: 1 when no contract ID is set.
NEXT_PUBLIC_USE_FIXTURE=

# Absolute origin of this deployment, used by robots.txt and the sitemap.
# Default: https://quorum.stellar.org
NEXT_PUBLIC_SITE_URL=
