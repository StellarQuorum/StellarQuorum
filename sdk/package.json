{
  "name": "@quorum/sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for interacting with Quorum governance contracts on Stellar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StellarQuorum/StellarQuorum.git",
    "directory": "sdk"
  },
  "keywords": [
    "stellar",
    "soroban",
    "governance",
    "quorum",
    "dao",
    "sdk"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./freighter": {
      "import": {
        "types": "./dist/esm/freighter.d.ts",
        "default": "./dist/esm/freighter.js"
      },
      "require": {
        "types": "./dist/cjs/freighter.d.ts",
        "default": "./dist/cjs/freighter.js"
      }
    },
    "./react": {
      "import": { "types": "./dist/esm/react.d.ts", "default": "./dist/esm/react.js" },
      "require": { "types": "./dist/cjs/react.d.ts", "default": "./dist/cjs/react.js" }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/finalize-dist.mjs",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest test/e2e",
    "test:smoke": "node scripts/smoke.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "verify": "npm run lint && npm run build && npm test -- --ci && npm run test:smoke && npm run test:browser",
    "check:publish": "node scripts/check-published.mjs",
    "prepublishOnly": "npm run build && npm run test:smoke",
    "lint": "eslint src test",
    "spec": "node scripts/generate-client-spec.mjs",
    "spec:check": "node scripts/generate-client-spec.mjs --check",
    "docs": "node scripts/generate-api-docs.mjs",
    "docs:check": "node scripts/generate-api-docs.mjs --check",
    "bench": "node bench/proposal-list.bench.mjs"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "~17.1.0"
  },
  "peerDependencies": {
    "@stellar/freighter-api": "^6.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@stellar/freighter-api": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stellar/freighter-api": "~6.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jest": "^29.0.0",
    "react": "^18.3.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.1"
  }
}
